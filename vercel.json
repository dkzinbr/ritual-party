{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/uploads/:file", "destination": "/api" },
    { "source": "/fotos/:file", "destination": "/api" },
    { "source": "/mestre", "destination": "/index.html" },
    { "source": "/mestre/", "destination": "/index.html" }
  ]
}
